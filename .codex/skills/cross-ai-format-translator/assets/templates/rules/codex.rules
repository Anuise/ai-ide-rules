# 這是 Codex exec_rule 範本，需以 Codex 官方規則文件為準調整。
# 建議在實際使用前以 `codex execpolicy check` 驗證。

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    match = [
        "git status",
    ],
    not_match = [
        "git diff",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "會把本機變更送到遠端。",
    match = [
        "git push origin main",
    ],
    not_match = [
        "git status",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "請改用較安全的逐步刪除流程。",
    match = [
        "rm -rf build",
    ],
    not_match = [
        "rmdir build",
    ],
)
